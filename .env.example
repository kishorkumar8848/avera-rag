# Vyoma Offline Medical AI Assistant - Environment Configuration
PROJECT_NAME="Vyoma Offline Medical AI Assistant"
ENVIRONMENT="production"
LOG_LEVEL="INFO"
DEBUG=false

# Display & Hardware (Waveshare 7-inch HDMI Touchscreen)
UI_WIDTH=1024
UI_HEIGHT=600
FULLSCREEN=true

# Audio Devices (Jetson Orin Nano USB mic / DAC)
AUDIO_INPUT_DEVICE="plughw:1,0"
AUDIO_OUTPUT_DEVICE="plughw:0,0"
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
VAD_ENERGY_THRESHOLD=0.015
VAD_SILENCE_DURATION=1.2

# Camera (CSI / USB Camera)
CAMERA_INDEX=0
CAMERA_BACKEND="opencv"
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# LLM Runtime (Preferred: llama_cpp with CUDA; Fallback: ollama)
LLM_BACKEND="llama_cpp"
LLM_MODEL_PATH="models/qwen2.5-1.5b-instruct-q4_k_m.gguf"
LLM_TEMPERATURE=0.15
LLM_TOP_P=0.85
LLM_MAX_NEW_TOKENS=512
LLM_N_CTX=2048
LLM_N_GPU_LAYERS=28
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:1.5b"

# Vision Model (Moondream 0.5B INT4)
MOONDREAM_MODEL_PATH="models/moondream-0_5b-int4"
MOONDREAM_MAX_TOKENS=100

# Speech Stack (Bhashini Local Services & Models)
BHASHINI_MODELS_DIR="models/bhashini"
BHASHINI_ASR_URL="http://localhost:8001/asr"
BHASHINI_NMT_URL="http://localhost:8002/nmt"
BHASHINI_TTS_URL="http://localhost:8003/tts"
ASR_PROVIDER="bhashini"
TTS_PROVIDER="bhashini"

# RAG & Embeddings
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
MEDLINEPLUS_XML_PATH="data/medlineplus/mplus_topics.xml"
INDIAN_PROTOCOLS_DIR="data/indian_protocols"
SQLITE_DB_PATH="indexes/medical_kb.db"
FAISS_INDEX_DIR="indexes/faiss"
TOP_K_RETRIEVAL=5
TOP_K_CONTEXT=4

# Memory Safety (8GB Hard Ceiling)
MAX_RAM_PERCENT=85.0
WARN_RAM_PERCENT=75.0
AUTO_UNLOAD_MODELS=true
